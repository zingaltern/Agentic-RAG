# ---- 环境与密钥（禁止入库） ----
.env
.env.local
.env.*.local

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.uv/
dist/
!frontend/dist/
build/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- 运行时数据（Chroma、日志、报告） ----
data/
reports/
*.log
# 验收/端到端临时产物（浏览器 profile、截图、脚本、npm cache）
.acceptance-tmp/

# ---- 本地模型缓存（在仓库外，保险起见也排除） ----
.cache/

# ---- macOS ----
.DS_Store

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp

# ---- 前端（W7：node_modules 与 dev 日志不入库；frontend/dist 按 AGENTS.md 提交供托管） ----
node_modules/
frontend/*.log
npm-debug.log*
# ---- 打包产物（electron-builder 输出；含二进制 App/DMG，不入库） ----
frontend/release/
# 外部基准测试集原始数据（8.4，可由 build_review_set 重新下载）
tests/review/raw/
