.cache/

# ---- macOS ----
.DS_Store

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp

# ---- 前端（W7：node_modules 与 dev 日志不入库；frontend/dist 按 AGENTS.md 提交供托管） ----
frontend/node_modules/
frontend/*.log
npm-debug.log*