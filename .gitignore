# ---- 环境与密钥（禁止入库） ----
.env
.env.local
.env.*.local

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.uv/
dist/
!frontend/dist/
build/
.coverage
.coverage.*
htmlcov/

# ---- 运行时数据（Chroma、日志、报告） ----
data/
reports/
*.log

