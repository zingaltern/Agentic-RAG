{
  "name": "agentic-rag-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "test:unit": "node --test src/api/*.test.js src/utils/*.test.js",
    "test:desktop": "node --test electron/*.test.cjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "element-plus": "^2.9.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.agenticrag.desktop",
    "productName": "AgenticRAG",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "directories": {
      "output": "release"
    }
  }
}
