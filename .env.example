# 复制为 .env 后填写，真实密钥绝不入库（.gitignore 已排除 .env）
# LLM = DeepSeek（OpenAI 兼容，默认 provider=deepseek）
RAG_DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 以下按需覆盖 DEVELOPMENT.md 第 4 章默认配置（均可省略）
# RAG_LLM_PROVIDER=deepseek
# RAG_LLM_MODEL=deepseek-chat
# RAG_EMBEDDING_PROVIDER=local_bge_v15
# RAG_EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# RAG_VECTOR_STORE_PROVIDER=chroma
# RAG_RETRIEVER_PROVIDER=hybrid_rrf
# RAG_LOG_LEVEL=info
# 团队模式首管理员（auth_enabled=true 时生效，见 PRODUCT_MANUAL.md）
# RAG_ADMIN_USER=admin
# RAG_ADMIN_PASSWORD=change-me

# 联网搜索（A5，Tavily）：开启前端「联网搜索」或 settings.yaml 的 web.enabled 后生效，
# 不配置则联网检索静默跳过（不影响本地问答）。需在 https://tavily.com 申请 key。
# RAG_TAVILY_API_KEY=tvly-your-tavily-api-key
